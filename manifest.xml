<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp 
  xmlns="http://microsoft.com" 
  xmlns:xsi="http://w3.org" 
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" 
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides" 
  xsi:type="TaskPaneApp">

  <!-- ID unik berformat GUID resmi (Jangan diubah strukturnya) -->
  <Id>d3b07384-d112-4c28-9c96-03c00494cf56</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Perusahaan Saya</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  
  <!-- Nama dan Deskripsi Add-in -->
  <DisplayName DefaultValue="Add-in Sederhana Saya" />
  <Description DefaultValue="Sebuah add-in Word sederhana untuk demonstrasi." />
  
  <!-- Ikon wajib berstatus HTTPS valid -->
  <IconUrl DefaultValue="https://microsoft.com" />
  <HighResolutionIconUrl DefaultValue="https://microsoft.com" />

  <!-- Penempatan Target Aplikasi (Word) -->
  <Hosts>
    <Host Name="Document" />
  </Hosts>

  <!-- Lokasi File HTML Utama (Pastikan diakhiri dengan /index.html) -->
  <DefaultSettings>
    <SourceLocation DefaultValue="https://remrame.github.io/ramerameaddins/index.html" />
  </DefaultSettings>

  <!-- Tingkat Izin Akses Dokumen -->
  <Permissions>ReadWriteDocument</Permissions>
</OfficeApp>
